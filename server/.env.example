# ============================================================
# WebSentinel Backend Configuration
# ============================================================

# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=4000

# Client Application URL (for CORS policy)
CLIENT_URL=http://localhost:3000

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# PostgreSQL Connection String (configured in Phase 4)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/websentinel

# Ingestion Security (for future authenticated server-to-server ingestion)
INGESTION_API_KEY=dev-sample-ingestion-key-change-in-prod
